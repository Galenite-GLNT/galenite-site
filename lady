<!doctype html>
<html lang="ru">
<head>
  <meta charset="UTF-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1.0" />
  <title>С 8 марта! — Galenite</title>
  <style>
    :root {
      --bg-1: #1a0f2b;
      --bg-2: #3e1a57;
      --accent: #ff5cab;
      --accent-2: #ffd1e8;
      --text: #fff6fb;
    }

    * { box-sizing: border-box; }

    body {
      margin: 0;
      min-height: 100vh;
      font-family: "Inter", "Segoe UI", system-ui, sans-serif;
      color: var(--text);
      background: radial-gradient(circle at top, #53206f 0%, var(--bg-1) 45%, #09050f 100%);
      display: grid;
      place-items: center;
      overflow: hidden;
    }

    .content {
      width: min(740px, 92vw);
      text-align: center;
      z-index: 3;
      position: relative;
      padding: 24px;
    }

    h1 {
      margin: 0 0 24px;
      font-size: clamp(2.2rem, 5vw, 4rem);
      text-shadow: 0 0 30px rgba(255, 117, 182, 0.55);
    }

    button {
      border: none;
      border-radius: 999px;
      padding: 14px 24px;
      font-size: 1.05rem;
      font-weight: 700;
      cursor: pointer;
      color: #290021;
      background: linear-gradient(135deg, #ff86c3, #ffd2ea);
      box-shadow: 0 10px 25px rgba(255, 78, 166, 0.35);
      transition: transform .2s ease, box-shadow .2s ease;
    }

    button:hover {
      transform: translateY(-2px) scale(1.02);
      box-shadow: 0 14px 28px rgba(255, 78, 166, 0.45);
    }

    .message {
      margin-top: 26px;
      font-size: clamp(1.05rem, 2.4vw, 1.35rem);
      line-height: 1.55;
      opacity: 0;
      transform: translateY(16px);
      transition: opacity .8s ease, transform .8s ease;
      max-width: 640px;
      margin-inline: auto;
      background: rgba(255, 255, 255, 0.08);
      border: 1px solid rgba(255, 177, 219, 0.35);
      border-radius: 18px;
      padding: 18px;
      backdrop-filter: blur(6px);
    }

    .active .message {
      opacity: 1;
      transform: translateY(0);
    }

    .heart {
      position: absolute;
      width: 16px;
      height: 16px;
      background: var(--accent);
      transform: rotate(45deg);
      opacity: 0;
      z-index: 1;
      animation: rise linear forwards;
      filter: drop-shadow(0 0 6px rgba(255, 114, 183, 0.65));
    }

    .heart::before,
    .heart::after {
      content: "";
      position: absolute;
      width: 16px;
      height: 16px;
      border-radius: 50%;
      background: inherit;
    }

    .heart::before { left: -8px; }
    .heart::after { top: -8px; }

    .spark {
      position: absolute;
      width: 10px;
      height: 10px;
      border-radius: 50%;
      z-index: 2;
      animation: pop 1.2s ease-out forwards;
      pointer-events: none;
    }

    @keyframes rise {
      0% { opacity: 0; transform: translateY(15vh) scale(0.8) rotate(45deg); }
      12% { opacity: 1; }
      100% { opacity: 0; transform: translateY(-105vh) translateX(var(--drift, 0px)) scale(1.4) rotate(45deg); }
    }

    @keyframes pop {
      from { opacity: 1; transform: translate(0, 0) scale(1); }
      to { opacity: 0; transform: translate(var(--x), var(--y)) scale(0.2); }
    }

    .aurora {
      position: absolute;
      inset: -20%;
      background:
        radial-gradient(circle at 25% 30%, rgba(255, 95, 179, 0.22) 0%, transparent 40%),
        radial-gradient(circle at 75% 30%, rgba(174, 105, 255, 0.18) 0%, transparent 42%),
        radial-gradient(circle at 50% 75%, rgba(255, 188, 225, 0.18) 0%, transparent 50%);
      filter: blur(10px);
      z-index: 0;
      animation: glow 6s ease-in-out infinite alternate;
    }

    @keyframes glow {
      from { transform: translateY(0) scale(1); }
      to { transform: translateY(-2%) scale(1.08); }
    }
  </style>
</head>
<body>
  <div class="aurora"></div>
  <main class="content" id="content">
    <h1>С 8 марта!</h1>
    <button id="startBtn" type="button">запустить поздравление</button>

    <p class="message" id="message">
      Милые дамы, команда Галенита поздравляет вас с праздником весны!<br>
      Пусть каждый день будет наполнен теплом, улыбками и красивыми победами.<br>
      Спасибо за вашу мудрость, вдохновение и энергию — вы делаете мир ярче! 💐
    </p>
  </main>

  <script>
    const startBtn = document.getElementById('startBtn');
    const content = document.getElementById('content');

    let heartInterval = null;

    function spawnHeart() {
      const heart = document.createElement('span');
      heart.className = 'heart';
      const size = 10 + Math.random() * 18;
      const left = Math.random() * 100;
      const duration = 4 + Math.random() * 4;
      const hue = 330 + Math.floor(Math.random() * 20);

      heart.style.left = `${left}vw`;
      heart.style.bottom = '-20px';
      heart.style.width = `${size}px`;
      heart.style.height = `${size}px`;
      heart.style.background = `hsl(${hue}, 95%, 68%)`;
      heart.style.setProperty('--drift', `${-40 + Math.random() * 80}px`);
      heart.style.animationDuration = `${duration}s`;

      document.body.appendChild(heart);
      setTimeout(() => heart.remove(), duration * 1000);
    }

    function explodeSparks(x, y) {
      const colors = ['#ffd1e8', '#ff7bc2', '#c29dff', '#ffe6f4'];
      for (let i = 0; i < 20; i++) {
        const spark = document.createElement('span');
        spark.className = 'spark';
        spark.style.left = `${x}px`;
        spark.style.top = `${y}px`;
        spark.style.background = colors[i % colors.length];

        const angle = Math.random() * Math.PI * 2;
        const distance = 35 + Math.random() * 90;
        spark.style.setProperty('--x', `${Math.cos(angle) * distance}px`);
        spark.style.setProperty('--y', `${Math.sin(angle) * distance}px`);

        document.body.appendChild(spark);
        setTimeout(() => spark.remove(), 1200);
      }
    }

    startBtn.addEventListener('click', () => {
      content.classList.add('active');
      startBtn.disabled = true;
      startBtn.textContent = 'Поздравление запущено ✨';

      explodeSparks(window.innerWidth / 2, window.innerHeight / 2);

      if (!heartInterval) {
        for (let i = 0; i < 14; i++) setTimeout(spawnHeart, i * 120);
        heartInterval = setInterval(spawnHeart, 250);
        setTimeout(() => {
          clearInterval(heartInterval);
          heartInterval = null;
        }, 10000);
      }
    });
  </script>
</body>
</html>
